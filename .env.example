# ── database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── fetching ────────────────────────────────────────────────────────────────
# tikwm is the primary key-less source. Point this at a mirror if it is blocked
# from your network.
# TIKWM_BASE_URL=https://www.tikwm.com

# Optional: a cookie from a logged-out tiktok.com tab. It makes the direct
# tiktok.com reads (embed / video pages) much more reliable.
# TIKTOK_COOKIE=ttwid=...; tt_webid_v2=...

# Optional: your own fetch service (see tools/tiktok-sidecar). Used before any
# public scraper when set.
# TIKTOK_FETCH_URL=http://127.0.0.1:8787
# TIKTOK_FETCH_TOKEN=

# Optional: egress proxy for tikwm / tiktok.com requests. Datacenter IPs (Vercel,
# Lambda) get 403 "bot challenge" from Cloudflare; a Cloudflare Worker fixes it.
# See tools/tiktok-proxy-worker.
# TIKTOK_PROXY_URL=https://your-worker.workers.dev/
# TIKTOK_PROXY_SECRET=

# When no proxy is set, the server may borrow a free key-less ?url= relay
# (allorigins / corsproxy.io / cors.lol) if a host refuses its IP. Set to "off"
# to never do that.
# TIKTOK_PUBLIC_RELAY=on

# ── posting without a developer account (recommended) ───────────────────────
# Paste the sessionid on the Publish tab instead of setting it here.
# TIKTOK_SESSION_ID=
# cli (run tiktok-uploader) | http (POST to an uploader service) | off
# TIKTOK_UPLOAD_MODE=auto
# Placeholders: {file} {caption} {cookies} {visibility}
# TIKTOK_UPLOADER_CMD=tiktok-uploader -v {file} -d {caption} -c {cookies}
# TIKTOK_UPLOADER_URL=http://127.0.0.1:9090/upload
# TIKTOK_UPLOADER_TOKEN=
# TIKTOK_COOKIES_FILE=
# TIKTOK_UPLOADER_TIMEOUT_MS=240000

# ── posting through the official Content Posting API (optional) ─────────────
# Requires a TikTok developer app with the Content Posting API product + an
# approved app for public posts. Not needed for the session route above.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=
# TIKTOK_ACCESS_TOKEN=
